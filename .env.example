# Добавьте в Netlify: Site settings -> Environment variables
PAYMENT_PROVIDER=tochka         # tochka или yookassa
TOCHKA_JWT=                     # Точка: Интеграции и API -> JWT-ключ
TOCHKA_CUSTOMER_CODE=           # код клиента Точки (9 цифр)
TOCHKA_MERCHANT_ID=             # ID торговой точки (15 цифр), если их несколько
TOCHKA_TAX_SYSTEM=usn_income    # система налогообложения для чека
TOCHKA_API_URL=https://enter.tochka.com/uapi   # тест: https://enter.tochka.com/sandbox/v2
IG_ACCESS_TOKEN=                # токен Instagram API (продлевается сайтом сам)
ADMIN_PASSWORD=                 # пароль страницы /admin.html, от 10 символов
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_CITY_CODE=      # код города отправки в СДЭК (Екатеринбург = 250)
CDEK_API_URL=https://api.cdek.ru/v2   # тест: https://api.edu.cdek.ru/v2
SITE_URL=https://ваш-сайт.netlify.app
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SMSRU_API_ID=
SMSRU_FROM=            # имя отправителя, если одобрено в SMS.ru (необязательно)
SMSRU_TEST=              # 1 = тестовый режим, SMS не отправляются
SEND_SMS_HOOK_SECRET=    # из Supabase: Authentication -> Hooks -> Send SMS
